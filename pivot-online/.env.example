# ===== PIVOT ONLINE — variables d'environnement =====
# Copie ce fichier en .env pour le développement local.
# Sur render.com, ces variables sont injectées automatiquement (voir render.yaml).

# URL de connexion PostgreSQL (render.com l'injecte depuis le service DB)
DATABASE_URL=postgres://ben_pivot:pivot_game_pw@mysql-ben.alwaysdata.net:5432/

# Secret pour signer les JWT (render.com peut le générer avec generateValue: true)
JWT_SECRET=change-moi-en-production-avec-une-vraie-chaine-aleatoire

# Port d'écoute du serveur (render.com injecte PORT automatiquement)
PORT=3000

# Environnement
NODE_ENV=development
